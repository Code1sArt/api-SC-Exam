NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://root:your_url_encoded_password@127.0.0.1:3306/scexamDB"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_SECONDS=86400
CORS_ORIGINS="https://labedu.tech,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"

# GPT Luna (OpenAI-compatible chat completion API)
AI_GENERATION_BASE_URL="https://api.openai.com/v1"
AI_GENERATION_API_KEY=""
AI_GENERATION_MODEL="gpt-5.6-luna"

# Google Gemini REST API; model names remain configurable
GEMINI_API_KEY=""
AI_REASONING_MODEL="gemini-2.5-flash"
AI_REPORT_MODEL="gemini-2.5-flash-lite"

# Set true for local development without external AI credentials
AI_MOCK_MODE=false

# Self-hosted Piston. The browser never connects to this URL directly.
PISTON_BASE_URL="http://127.0.0.1:2000/api/v2"
PISTON_C_VERSION="10.2.0"
PISTON_CPP_VERSION="10.2.0"
PISTON_CSHARP_VERSION="6.12.0"
PISTON_PYTHON_VERSION="3.12.0"
